# Copy to `.env` and fill in. Never commit the real `.env`.
#
# Only `NEXT_PUBLIC_*` values reach the browser. Everything else below is read
# exclusively in server code (`src/lib/email.ts`, `src/lib/turnstile.ts`) and
# must never be given that prefix, or Next inlines it into the client bundle.

# Resend API key. Create at https://resend.com -> API Keys (sending access).
RESEND_API =

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL = info@dragmolabs.com

# Sender for both the notification and the auto-reply. The address must sit on
# a domain verified in Resend, or the API rejects the send with a 403.
CONTACT_FROM_EMAIL = Dragmo Labs <noreply@mail.dragmolabs.com>

# Cloudflare Turnstile, the contact form's bot check. Create a widget at
# https://dash.cloudflare.com -> Turnstile. The hostname list must include
# `localhost` as well as the production domain, or `npm run dev` is rejected.
# The site key needs the NEXT_PUBLIC_ prefix to reach the browser bundle; the
# secret key must never carry it. Both are required in production — the API
# route refuses submissions rather than skipping the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY =
TURNSTILE_SECRET_KEY =

# Google Analytics 4 measurement ID, from Admin -> Data Streams in GA4. Unlike
# the secrets above, this is meant to be public — it ships in the page source
# of every GA-instrumented site — so the NEXT_PUBLIC_ prefix here is intentional
# rather than a leak. Analytics is skipped entirely when this is unset, and
# skipped on localhost even when it is set (see src/lib/analytics.ts); set
# NEXT_PUBLIC_GA_ALLOW_LOCALHOST=true locally to verify events in GA DebugView.
NEXT_PUBLIC_GA_MEASUREMENT_ID = G-XXXXXXXXXX
